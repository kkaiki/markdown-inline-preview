    "customEditors": [
      {
        "viewType": "ipreview.live",
        "displayName": "Markdown Live (Obsidian-style)",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownInline.openLive",
          "when": "editorLangId == markdown",
          "group": "navigation@0"
        },
        {
          "command": "markdownInline.exportPdf",
          "when": "editorLangId == markdown",
          "group": "9_export@10"
        },
        {
          "command": "markdownInline.exportDocx",
          "when": "markdownInline.proPlusOnSale && editorLangId == markdown",
          "group": "9_export@20"
        },
        {
          "command": "markdownInline.exportMarp",
          "when": "markdownInline.proPlusOnSale && editorLangId == markdown",
          "group": "9_export@30"
        }
      ],
      "webview/context": [
        {
          "command": "markdownInline.openRaw",
          "when": "webviewId == 'ipreview.live'",
          "group": "navigation@0"
        },
        {
          "command": "markdownInline.exportPdf",
          "when": "webviewId == 'ipreview.live'",
          "group": "9_export@10"
        },
        {
          "command": "markdownInline.exportDocx",
          "when": "markdownInline.proPlusOnSale && webviewId == 'ipreview.live'",
          "group": "9_export@20"
        },
        {
          "command": "markdownInline.exportMarp",
          "when": "markdownInline.proPlusOnSale && webviewId == 'ipreview.live'",
          "group": "9_export@30"
        }
      ],
      "editor/title": [
        {
          "command": "markdownInline.openLive",
          "when": "editorLangId == markdown && activeCustomEditorId != 'ipreview.live'",
          "group": "navigation@1"
        },
        {
          "command": "markdownInline.toggleLive",
          "when": "activeCustomEditorId == 'ipreview.live'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownInline.openLive",
          "when": "resourceLangId == markdown",
          "group": "navigation@10"
        },
        {
          "command": "markdownInline.batchExport",
          "when": "markdownInline.proPlusOnSale && (explorerResourceIsFolder || resourceExtname =~ /^\\.(md|markdown)$/i)",
          "group": "7_modification@90"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownInline.openLive",
          "when": "resourceLangId == markdown",
          "group": "1_open@10"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownInline.noop",
          "when": "false"
        },
        {
          "command": "markdownInline.exportMarp",
          "when": "markdownInline.proPlusOnSale && (editorLangId == markdown || activeCustomEditorId == 'ipreview.live')"
        },
        {
          "command": "markdownInline.exportDocx",
          "when": "markdownInline.proPlusOnSale && (editorLangId == markdown || activeCustomEditorId == 'ipreview.live')"
        },
        {
          "command": "markdownInline.batchExport",
          "when": "markdownInline.proPlusOnSale"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownInline.smartMoveLeft",
        "key": "cmd+left",
        "mac": "cmd+left",
        "win": "home",
        "linux": "home",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "markdownInline.smartSelectLeft",
        "key": "shift+cmd+left",
        "mac": "shift+cmd+left",
        "win": "shift+home",
        "linux": "shift+home",
        "when": "editorTextFocus && editorLangId == markdown"
