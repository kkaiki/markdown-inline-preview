    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "glob": "^8.0.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "mocha": "^10.2.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
