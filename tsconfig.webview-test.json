{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": false,
    "types": ["mocha", "node", "jsdom"]
  },
  "include": [
    "test/webview/**/*.ts",
    "src/preview/webview/previewKeymapPlugin.ts"
  ]
}
